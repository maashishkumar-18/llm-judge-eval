# Copy to .env and fill in. Never commit the real .env.

# --- API keys (one per provider) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Generator (produces model_output): Groq-hosted gpt-oss-20b (OpenAI family). ---
# `make smoke` FAILS if this id is not in Groq's /v1/models. Ids verified 2026-10-23; they change.
GEN_PROVIDER=groq
GEN_MODEL=openai/gpt-oss-20b
GEN_TEMPERATURE=0.0
GEN_CONCURRENCY=2
# low | medium | high
GEN_REASONING_EFFORT=low
# 1 = send include_reasoning=false and drop any `reasoning` field; only final `content` is kept/cached/logged
GEN_STRIP_REASONING=1

# --- Judge: Gemini (Google family). FINAL for this project: do not change mid-project, because every
# validation number is only valid for the judge that produced it. Must differ in family from the generator.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.5-flash-lite
JUDGE_TEMPERATURE=0.0
JUDGE_CONCURRENCY=2
# 0 = prompt-only JSON (exercises the parse ladder). 1 = provider JSON mode.
JUDGE_JSON_MODE=0

# --- Judge quota guards (free tier: 15 RPM, 250K TPM, 500 RPD) ---
# Sliding-window request limiter (every HTTP attempt counts), kept under 15 RPM:
JUDGE_RPM_LIMIT=12
# Hard cap on NON-cached judge calls per Pacific day; persistent ledger at LEDGER_PATH. Runs stop at the cap
# and resume from checkpoints.
JUDGE_DAILY_CAP=450
# Generous: Gemini thinking tokens count against the output limit.
JUDGE_MAX_TOKENS=8192
LEDGER_PATH=.cache/judge_ledger.json

# Set to 1 ONLY to deliberately judge with the generator's family (logs a warning).
ALLOW_SAME_FAMILY=0

# --- Client hygiene ---
MAX_RETRIES=6
BACKOFF_BASE_SECONDS=2.0
BACKOFF_MAX_SECONDS=60.0
REQUEST_TIMEOUT_SECONDS=120

# --- Paths ---
CACHE_DIR=.cache/llm
LOG_DIR=logs
