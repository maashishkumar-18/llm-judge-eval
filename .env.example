# Copy to .env and fill in. Never commit the real .env.

# --- API keys (one per provider) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Generator (produces model_output): Groq-hosted gpt-oss (OpenAI family). ---
# Ids verified against official docs / live listing 2026-10-23; re-check, they change.
GEN_PROVIDER=groq
GEN_MODEL=openai/gpt-oss-120b
GEN_TEMPERATURE=0.0
GEN_CONCURRENCY=2
# low | medium | high
GEN_REASONING_EFFORT=low
# 1 = send include_reasoning=false and drop any `reasoning` field; only final `content` is kept/cached/logged
GEN_STRIP_REASONING=1

# --- Judge: Gemini (Google family). Strongest model that works on the free key as of 2026-10-23
# (gemini-4-argon and the *-pro models returned 429 quota errors on the first call). Must be a
# different family than the generator (family guard). Free-tier 503 "high demand" is retried.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.8-flash
JUDGE_TEMPERATURE=0.0
JUDGE_CONCURRENCY=2
# 0 = prompt-only JSON (exercises the parse ladder). 1 = provider JSON mode (responseMimeType / json_object).
JUDGE_JSON_MODE=0

# Set to 1 ONLY to deliberately judge with the generator's family (logs a warning).
ALLOW_SAME_FAMILY=0

# --- Client hygiene ---
MAX_RETRIES=6
BACKOFF_BASE_SECONDS=2.0
BACKOFF_MAX_SECONDS=60.0
REQUEST_TIMEOUT_SECONDS=120

# --- Paths ---
CACHE_DIR=.cache/llm
LOG_DIR=logs
