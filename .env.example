# Copy to .env and fill in. Never commit the real .env.

# --- API keys (one per provider) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Generator (produces model_output). Ids verified against official docs 2026-10-23; re-check, they change. ---
GEN_PROVIDER=gemini
GEN_MODEL=gemini-3.5-flash-lite
GEN_TEMPERATURE=0.0
GEN_CONCURRENCY=2

# --- Judge. Must be a different model family than the generator (family guard). ---
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-120b
JUDGE_TEMPERATURE=0.0
JUDGE_CONCURRENCY=2
# gpt-oss on Groq: low | medium | high
JUDGE_REASONING_EFFORT=medium

# Set to 1 ONLY to deliberately judge with the generator's family (logs a warning).
ALLOW_SAME_FAMILY=0

# --- Client hygiene ---
MAX_RETRIES=6
BACKOFF_BASE_SECONDS=2.0
BACKOFF_MAX_SECONDS=60.0
REQUEST_TIMEOUT_SECONDS=120

# --- Paths ---
CACHE_DIR=.cache/llm
LOG_DIR=logs
